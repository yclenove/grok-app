# Normalize source and documentation without changing binary resources.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.woff2 binary
*.zip binary
# A unified diff's context marker precedes original tabs and blank lines.
*.patch whitespace=-blank-at-eol,-space-before-tab
# Markdown hard breaks and archived report spacing are intentional.
*.md whitespace=-blank-at-eol,-blank-at-eof
