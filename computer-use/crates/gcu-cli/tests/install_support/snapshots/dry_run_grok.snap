---
source: crates/gcu-cli/tests/install_support/wire.rs
---
# grok install
--- $HOME/.grok/config.toml
+++ $HOME/.grok/config.toml
@@ -1,0 +1,3 @@
+[mcp_servers.grok-computer-use]
+command = "$GCU"
+args = ["mcp"]
--- $HOME/.grok/hooks/computer-use-stop.json
+++ $HOME/.grok/hooks/computer-use-stop.json
@@ -1,0 +1,15 @@
+{
+  "hooks": {
+    "Stop": [
+      {
+        "hooks": [
+          {
+            "type": "command",
+            "command": "$HOME/.grok/hooks/$HOOK_FILE",
+            "timeout": 10
+          }
+        ]
+      }
+    ]
+  }
+}
--- $HOME/.grok/hooks/$HOOK_FILE
+++ $HOME/.grok/hooks/$HOOK_FILE
@@ -1,0 +1,9 @@
+$HOOK
