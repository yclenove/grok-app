# cursor install
--- $HOME/.cursor/mcp.json
+++ $HOME/.cursor/mcp.json
@@ -1,0 +1,11 @@
+{
+  "mcpServers": {
+    "grok-computer-use": {
+      "type": "stdio",
+      "command": "$GCU",
+      "args": [
+        "mcp"
+      ]
+    }
+  }
+}
