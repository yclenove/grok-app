 }
 
+static gboolean
+retire_remote_desktop_dialog_idle (gpointer user_data)
+{
+  remote_desktop_dialog_handle_close (user_data);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+disconnect_ready_handler (RemoteDesktopSession *session)
+{
+  if (session->session_ready_handler_id == 0 ||
+      session->gnome_screen_cast_session == NULL)
+    return;
+
+  g_signal_handler_disconnect (session->gnome_screen_cast_session,
+                               session->session_ready_handler_id);
+  session->session_ready_handler_id = 0;
+}
+
+static gboolean
+complete_start_invocation (RemoteDesktopSession *session,
+                           int response,
+                           GVariant *results)
+{
+  GDBusMethodInvocation *invocation;
+
+  invocation = g_steal_pointer (&session->start_invocation);
+  if (invocation == NULL)
+    {
+      if (results != NULL)
+        g_variant_unref (g_variant_ref_sink (results));
+      return FALSE;
+    }
+
+  xdp_impl_remote_desktop_complete_start (XDP_IMPL_REMOTE_DESKTOP (impl),
+                                          invocation,
+                                          response,
+                                          results);
+  return TRUE;
+}
+
+static void
+retire_remote_desktop_dialog (RemoteDesktopSession *session)
+{
+  RemoteDesktopDialogHandle *dialog_handle;
+
+  dialog_handle = g_steal_pointer (&session->dialog_handle);
+  if (dialog_handle == NULL)
+    return;
+
+  if (dialog_handle->request != NULL)
+    g_signal_handlers_disconnect_by_data (dialog_handle->request, dialog_handle);
+  if (dialog_handle->dialog != NULL)
+    g_signal_handlers_disconnect_by_data (dialog_handle->dialog, dialog_handle);
+
+  g_idle_add (retire_remote_desktop_dialog_idle, dialog_handle);
+}
+
 static void
 cancel_start_session (RemoteDesktopSession *remote_desktop_session,
                       int response)
 {
   GVariantBuilder results_builder;
 
+  disconnect_ready_handler (remote_desktop_session);
   g_variant_builder_init (&results_builder, G_VARIANT_TYPE_VARDICT);
-  xdp_impl_remote_desktop_complete_start (XDP_IMPL_REMOTE_DESKTOP (impl),
-                                          remote_desktop_session->start_invocation,
-                                          response,
-                                          g_variant_builder_end (&results_builder));
+  complete_start_invocation (remote_desktop_session,
+                             response,
+                             g_variant_builder_end (&results_builder));
 }
 
